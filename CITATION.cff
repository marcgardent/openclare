    given-names: Marc
    affiliation: Independent researcher
    orcid: "https://orcid.org/0009-0000-6466-3098"
license: GPL-3.0-or-later
repository-code: "https://github.com/marcgardent/openclare"
url: "https://marcgardent.github.io/openclare/"
keywords:
  - quad meshing
  - retopology
  - quantization
  - T-mesh
  - Lean
  - Blender
