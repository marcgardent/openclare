/target
*.obj
!assets/**/*.obj
# The meshes kept (made by hand) are data, not build products.
!bench/reference/**/*.obj
/bench/out
# The copy Blender keeps of a file it saves over.
*.blend1
# Full-resolution originals: too large for git, kept beside the repository data.
/bench/corpus-large
__pycache__
# The engine built into the Blender add-on, and the archives made of it.
/blender/openclare/lib
/dist
# The website as built by site/build.py.
/site/_build
# The commit a research paper describes, written by `make paper`.
/docs/research/*/version.tex
# The PDFs of the papers: built by `make paper`, and on GitHub by
# .github/workflows/papers.yml, which the website serves.
/docs/research/*/paper*.pdf
/docs/research/*/progress.json
# The bundle `make paper-arxiv` writes for arXiv.
/docs/research/*/arxiv.tar.gz
# What is not to be published: local challengers, their meshes and results
# (see bench/README.md).
/local
