/target
*.obj
!assets/**/*.obj
# The kept references are data, not build products.
!bench/reference/**/*.obj
/bench/out
# The copy Blender keeps of a file it saves over.
*.blend1
# Full-resolution originals: too large for git, kept beside the repository data.
/bench/corpus-large
__pycache__
# The engine built into the Blender add-on, and the archives made of it.
/blender/openclare/lib
/dist
# The website as built by site/build.py.
/site/_build
# The commit a research note describes, written by `make paper`.
/docs/research/*/version.tex
