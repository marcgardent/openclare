/-
The common base: motions and the quarter-turn group.

A motion `x ↦ a • x + t` is a `Motion A V`, its linear part `a` in a ring `A`
acting on an additive group `V`; `comp f g` is `f ∘ g` (`g` applied first).
Compositions of lists of motions and the Burgers sum are in `Motion.lean`.

The quarter-turn group is generated by `R(a, b) = (-b, a)`, of order four
(`orderOf_giUnit`). It is stated once, in the Gaussian integers `ℤ[i]`, the
plane of a patch at whole lengths: `R` is the multiplication by `gi`, and
`IsQuarter a` says that `a` is one of `1, R, R², R³`. At real lengths the plane
is `ℂ` and `R` the multiplication by `I`, the image of `gi` (`toComplex_gi`);
the modules on real lengths (`QuarterTurn`, `FirstVisit`, the twisted windings
of `Fox`) state their quarter-turns as `I` and `-I` there, and `BeyondQuads`
works with the rotation `ζₙ` of any order `n`.
-/
module

public import Mathlib.Algebra.Module.Defs
public import Mathlib.Algebra.Group.Units.Basic
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.NumberTheory.Zsqrtd.GaussianInt
public import Mathlib.Tactic.Abel

@[expose] public section

set_option linter.unusedSectionVars false

namespace TurnsOfATMesh

/-- A motion `x ↦ lin • x + trans`. -/
@[ext] structure Motion (A V : Type*) where
  /-- The linear part (a rotation, for the motions of the note). -/
  lin : A
  /-- The translation part. -/
  trans : V

namespace Motion

variable {A V : Type*} [Ring A] [AddCommGroup V] [Module A V]

/-- The motion as a map of `V`. -/
def apply (f : Motion A V) (x : V) : V := f.lin • x + f.trans

/-- `comp f g = f ∘ g`: `g` first. -/
def comp (f g : Motion A V) : Motion A V := ⟨f.lin * g.lin, f.trans + f.lin • g.trans⟩

/-- The identity motion. -/
def id : Motion A V := ⟨1, 0⟩

/-- The translation by `t`. -/
def translation (t : V) : Motion A V := ⟨1, t⟩

/-- The rotation `x ↦ a • (x - p) + p` about the point `p`, the holonomy of a
small loop round a cone point developed at `p`. -/
def rotAbout (a : A) (p : V) : Motion A V := ⟨a, p - a • p⟩

@[simp] theorem comp_lin (f g : Motion A V) : (comp f g).lin = f.lin * g.lin := rfl
@[simp] theorem comp_trans (f g : Motion A V) :
    (comp f g).trans = f.trans + f.lin • g.trans := rfl
@[simp] theorem id_lin : (id : Motion A V).lin = 1 := rfl
@[simp] theorem id_trans : (id : Motion A V).trans = 0 := rfl
@[simp] theorem translation_lin (t : V) : (translation t : Motion A V).lin = 1 := rfl
@[simp] theorem translation_trans (t : V) : (translation t : Motion A V).trans = t := rfl
@[simp] theorem rotAbout_lin (a : A) (p : V) : (rotAbout a p).lin = a := rfl
@[simp] theorem rotAbout_trans (a : A) (p : V) : (rotAbout a p).trans = p - a • p := rfl

theorem apply_comp (f g : Motion A V) (x : V) : (comp f g).apply x = f.apply (g.apply x) := by
  simp only [apply, comp, mul_smul, smul_add]; abel

theorem apply_rotAbout (a : A) (p x : V) : (rotAbout a p).apply x = a • (x - p) + p := by
  simp only [apply, rotAbout, smul_sub]; abel

theorem apply_translation (t x : V) : (translation t : Motion A V).apply x = x + t := by
  simp [apply, translation]

theorem comp_assoc (f g h : Motion A V) : comp (comp f g) h = comp f (comp g h) := by
  ext <;> simp [mul_assoc, mul_smul, smul_add, add_assoc]

@[simp] theorem comp_id (f : Motion A V) : comp f id = f := by ext <;> simp

@[simp] theorem id_comp (f : Motion A V) : comp id f = f := by ext <;> simp

/-- A motion with trivial linear part is the translation by its translation part. -/
theorem eq_translation_of_lin_eq_one (f : Motion A V) (h : f.lin = 1) :
    f = translation f.trans := by
  ext <;> simp [h]

/-- The inverse of a motion with invertible linear part. -/
def inv (f : Motion A V) (u : Aˣ) (_ : (u : A) = f.lin) : Motion A V :=
  ⟨(↑u⁻¹ : A), -((↑u⁻¹ : A) • f.trans)⟩

theorem comp_inv (f : Motion A V) (u : Aˣ) (h : (u : A) = f.lin) :
    comp f (inv f u h) = id := by
  ext
  · simp [inv, ← h]
  · simp [inv, ← h, smul_neg, ← mul_smul]

theorem inv_comp (f : Motion A V) (u : Aˣ) (h : (u : A) = f.lin) :
    comp (inv f u h) f = id := by
  ext
  · simp [inv, ← h]
  · simp [inv]

/-- The inverse of a rotation about `p` is the inverse rotation about `p`. -/
theorem inv_rotAbout (u : Aˣ) (p : V) :
    inv (rotAbout (u : A) p) u rfl = rotAbout (↑u⁻¹ : A) p := by
  ext
  · rfl
  · simp [inv, rotAbout, smul_sub, ← mul_smul]

end Motion

/-! ### The quarter-turn group -/

/-- `i`, the quarter-turn `R(a, b) = (-b, a)` of `ℤ²`. -/
def gi : GaussianInt := Zsqrtd.sqrtd

@[simp] theorem gi_re : gi.re = 0 := rfl
@[simp] theorem gi_im : gi.im = 1 := rfl

theorem gi_mul_gi : gi * gi = -1 := by ext <;> simp [gi]

/-- The quarter-turn as a unit. -/
def giUnit : GaussianIntˣ := ⟨gi, -gi, by rw [mul_neg, gi_mul_gi, neg_neg],
  by rw [neg_mul, gi_mul_gi, neg_neg]⟩

@[simp] theorem giUnit_val : (giUnit : GaussianInt) = gi := rfl

theorem giUnit_sq : giUnit ^ 2 = -1 := by
  ext : 1
  simp [sq, gi_mul_gi]

/-- `R` has order four: the quarter-turn group is `{1, R, R², R³}`. -/
theorem orderOf_giUnit : orderOf giUnit = 4 := by
  have h := orderOf_eq_prime_pow (p := 2) (n := 1) (x := giUnit) ?_ ?_
  · simpa using h
  · rw [pow_one, giUnit_sq]
    intro h2
    have := congrArg (fun u : GaussianIntˣ => ((u : GaussianInt)).re) h2
    simp at this
  · rw [show (2 : ℕ) ^ (1 + 1) = 2 * 2 from rfl, pow_mul, giUnit_sq]
    simp

/-- `R` is the multiplication by `i` of `ℂ` too: `ℤ[i]` sits in `ℂ`, `gi` at `I`. -/
theorem toComplex_gi : GaussianInt.toComplex gi = Complex.I := by
  rw [GaussianInt.toComplex_def₂]; apply Complex.ext <;> simp

/-- `a` is one of `1, R, R², R³`. -/
def IsQuarter (a : GaussianInt) : Prop := a = 1 ∨ a = gi ∨ a = -1 ∨ a = -gi

theorem IsQuarter.mul {a b : GaussianInt} (ha : IsQuarter a) (hb : IsQuarter b) :
    IsQuarter (a * b) := by
  unfold IsQuarter at *
  rcases ha with rfl | rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl <;>
    simp [gi_mul_gi]

theorem IsQuarter.one : IsQuarter 1 := Or.inl rfl

theorem IsQuarter.list_prod (l : List GaussianInt) (h : ∀ a ∈ l, IsQuarter a) :
    IsQuarter l.prod := by
  induction l with
  | nil => exact IsQuarter.one
  | cons a l ih =>
    rw [List.prod_cons]
    exact (h a (by simp)).mul (ih fun b hb => h b (by simp [hb]))

/-- Every power of `R` is one of `1, R, R², R³`. -/
theorem IsQuarter.zpow_giUnit (k : ℤ) :
    IsQuarter ((giUnit ^ k : GaussianIntˣ) : GaussianInt) := by
  have h4 : giUnit ^ (4 : ℤ) = 1 := by
    rw [show (4 : ℤ) = ((2 * 2 : ℕ) : ℤ) from rfl, zpow_natCast, pow_mul, giUnit_sq]; simp
  rw [← Int.emod_add_mul_ediv k 4, zpow_add, zpow_mul, h4, one_zpow, mul_one]
  have hr : k % 4 = 0 ∨ k % 4 = 1 ∨ k % 4 = 2 ∨ k % 4 = 3 := by omega
  rcases hr with h | h | h | h <;> rw [h] <;> unfold IsQuarter <;>
    simp [zpow_ofNat, pow_succ, gi_mul_gi]

end TurnsOfATMesh
